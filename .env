# Identifiants EmailJS — chargés en développement (npm run dev) ET en
# production (npm run build), pour un comportement identique partout.
#
# Ces trois valeurs sont publiques par conception : EmailJS les envoie au
# navigateur pour authentifier l'appel d'envoi (comme une clé API publique
# Stripe ou Google Maps). Elles finissent de toute façon dans le bundle
# JavaScript servi au public, visible via « Afficher le code source » sur
# le site déployé — les committer ici n'expose rien de plus.

VITE_EMAILJS_SERVICE_ID=service_9few8ed
VITE_EMAILJS_TEMPLATE_ID=template_gm0v24b
VITE_EMAILJS_TEMPLATE_ID_DOSSIER=template_9syr6ji
VITE_EMAILJS_PUBLIC_KEY=e2RmKYDS4fvd4v4-F

# Identifiants Supabase — système d'octroi d'accès après paiement.
#
# Comme pour EmailJS ci-dessus, l'URL de projet et la clé "anon" ne sont pas
# des secrets : elles finissent dans le bundle JavaScript public de toute
# façon, et l'accès réel est contrôlé côté serveur par Row Level Security
# (voir supabase/migrations/0001_access_requests.sql). La clé "service_role"
# (droits complets) ne doit JAMAIS figurer ici — uniquement comme secret des
# Edge Functions, configuré via `supabase secrets set`.

VITE_SUPABASE_URL=https://sroqcswtxmjzbsggkrjn.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InNyb3Fjc3d0eG1qemJzZ2drcmpuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwNzIxMjEsImV4cCI6MjEwNDY0ODEyMX0.Ee0o7TzBrHwxRE3dxUjg_oh_YA2jccaJdNKIhUhQk-s
