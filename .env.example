# Copiez ce fichier en « .env » et renseignez vos identifiants EmailJS.
# Récupérez-les sur https://dashboard.emailjs.com — voir src/lib/sendMail.js.
# Ces trois valeurs sont publiques par conception : elles finissent dans le
# bundle navigateur. Ce ne sont pas des secrets.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
