# Gabarit vierge — le fichier .env à la racine du dépôt contient déjà les
# vraies valeurs et est chargé automatiquement (voir son en-tête). Ce fichier
# ne sert que de référence, par exemple pour reconfigurer un autre compte
# EmailJS. Récupérez les identifiants sur https://dashboard.emailjs.com —
# voir src/lib/sendMail.js.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Optionnel — template dédié au dossier de candidature (32 champs), distinct
# du template de contact général ci-dessus. Laissez vide pour que le dossier
# utilise le même template que le contact (avec des champs vides pour les
# sections qui ne le concernent pas).
VITE_EMAILJS_TEMPLATE_ID_DOSSIER=

VITE_EMAILJS_PUBLIC_KEY=

# Identifiants Supabase — système d'octroi d'accès après paiement. Récupérez-les
# sur https://supabase.com/dashboard/project/<ref>/settings/api — voir
# src/lib/supabaseClient.js. La clé service_role ne va jamais dans un fichier
# .env de ce dépôt (voir supabase/functions/README.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
