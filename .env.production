# Identifiants EmailJS de production.
#
# Ces trois valeurs sont publiques par conception : EmailJS les envoie au
# navigateur pour authentifier l'appel d'envoi (comme une clé API publique
# Stripe ou Google Maps). Elles finiront de toute façon dans le bundle
# JavaScript servi au public, visible via « Afficher le code source » sur
# le site déployé — les committer ici n'expose rien de plus.
#
# Vite charge automatiquement ce fichier lors de `vite build` (mode
# production par défaut), donc le workflow GitHub Actions n'a besoin
# d'aucune modification pour que ces valeurs atteignent le site déployé.

VITE_EMAILJS_SERVICE_ID=service_9few8ed
VITE_EMAILJS_TEMPLATE_ID=template_gm0v24b
VITE_EMAILJS_TEMPLATE_ID_DOSSIER=template_9syr6ji
VITE_EMAILJS_PUBLIC_KEY=e2RmKYDS4fvd4v4-F
